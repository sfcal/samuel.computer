---
// Every page: the document head, the header bar, and the sky behind it all.
import { Font } from 'astro:assets';
import '../styles/base.css';

interface Props {
  title?: string;                       // omitted on the home page
  description?: string;
  image?: string;                       // shown when the page is shared
  published?: Date;                     // set on a post
  section?: 'projects' | 'writing';     // which of the bar's links to mark
  home?: boolean;
}

const NAME = 'Samuel Calvert';
const {
  title,
  description = 'Computer Engineering professional specializing in infrastructure automation, networking, and systems troubleshooting.',
  image = '/headshot.jpeg',
  published,
  section,
  home = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${NAME}` : NAME;
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const person = { '@type': 'Person', name: NAME, url: Astro.site };
const structured = published
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: published.toISOString(),
      image: imageUrl,
      mainEntityOfPage: url,
      author: person,
    }
  : {
      '@context': 'https://schema.org',
      ...person,
      jobTitle: 'Infrastructure Engineer',
      sameAs: ['https://github.com/sfcal', 'https://linkedin.com/in/samuel-f-calvert'],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structured)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-sans" preload />
    {/* the Moon is drawn in the bold monospace, so the home page wants it early */}
    <Font cssVariable="--font-mono" preload={home && [{ weight: 700 }]} />
    {home && <Font cssVariable="--font-display" />}

    {/* Before anything is painted, put the sky back as the last page left it
        (see scripts/state.js); a first visit starts in daylight. */}
    <script is:inline>
      try {
        const { day = 1 } = JSON.parse(sessionStorage.getItem('scene')) ?? {};
        if (day !== 1) document.documentElement.style.setProperty('--day', day);
        if (day < 0.5) document.documentElement.classList.add('night');
      } catch {}
      // a page shown while its tab is hidden skips the dissolve between pages, which is no error
      addEventListener('pagereveal', e => e.viewTransition?.ready.catch(() => {}));
      // The dissolve away from this page is skipped if it is left within two seconds of
      // arriving: Chrome, asked for a picture of a page it has only just drawn, now and
      // then captures a blank white sheet, and the next page would fade in from that
      // (seen when the bar's links are clicked in quick succession).
      addEventListener('pageswap', e => { if (performance.now() < 2000) e.viewTransition?.skipTransition(); });
    </script>
    {/* where the browser offers it, fetch a page of this site as soon as its link is hovered */}
    <script type="speculationrules" is:inline>
      { "prefetch": [{ "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/*.*" } }] }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body>
    {!home && <a class="skip" href="#content">Skip to content</a>}

    <svg class="defs" aria-hidden="true">
      <filter id="rim-refraction" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage id="rim-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map"></feImage>
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="B"></feDisplacementMap>
      </filter>
    </svg>

    <header class="bar">
      <nav class="glass" id="glass" aria-label="Main">
        <a class="logo" href="/" aria-label="SC, home">SC</a>
        <div class="pasture" id="pasture" aria-hidden="true"><canvas></canvas></div>
        <div class="links">
          <a href="/projects/" aria-current={section === 'projects' ? 'page' : undefined}>Projects</a>
          <a href="/writing/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/cv.pdf" target="_blank" rel="noopener noreferrer">CV</a>
        </div>
        <button type="button" id="phase" aria-label="Switch to night">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
        </button>
      </nav>
    </header>

    <div class="clouds" id="clouds" aria-hidden="true"></div>
    <div class="stars" id="stars" aria-hidden="true"></div>

    <slot />

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
