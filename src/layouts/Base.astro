---
// Every page: the document head, the header bar, and the sky behind it all.
import '../styles/base.css';

// The typefaces, served from this site: the Latin files of the @fontsource
// packages, in just the weights the pages use (the home page adds DynaPuff for
// the name). The woff2 files are imported by URL as well, so the preloads below
// point at the same hashed address as the @font-face rules and nothing is
// fetched twice.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import mono700 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url';

interface Props {
  title?: string;                       // omitted on the home page
  description?: string;
  image?: string;                       // shown when the page is shared
  published?: Date;                     // set on a post
}

const NAME = 'Samuel Calvert';
const {
  title,
  description = 'Computer Engineering professional specializing in infrastructure automation, networking, and systems troubleshooting.',
  image = '/headshot.jpeg',
  published,
} = Astro.props;

const home = Astro.url.pathname === '/';
const section = Astro.url.pathname.split('/')[1];   // which of the bar's links to mark
const fullTitle = title ? `${title} | ${NAME}` : NAME;
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const person = { '@type': 'Person', name: NAME, url: Astro.site };
const structured = published
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: published.toISOString(),
      image: imageUrl,
      mainEntityOfPage: url,
      author: person,
    }
  : {
      '@context': 'https://schema.org',
      ...person,
      jobTitle: 'Infrastructure Engineer',
      sameAs: ['https://github.com/sfcal', 'https://linkedin.com/in/samuel-f-calvert'],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structured)} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    {/* the Moon is drawn in the bold monospace, so the home page wants it early */}
    {home && <link rel="preload" href={mono700} as="font" type="font/woff2" crossorigin />}

    {/* Before anything is painted, put the sky back as the last page left it.
        That page saved, on leaving, the very values its script had painted
        (see the pagehide listener in scripts/sky.js), so the first frame and
        every frame after it agree: nothing jumps or flips when the script
        takes over. A first visit, with nothing saved, starts in daylight: the
        stylesheet's own defaults. */}
    <script is:inline>
      try {
        const saved = JSON.parse(sessionStorage.getItem('sky'));
        if (saved?.cloudsY) {
          const root = document.documentElement;
          root.style.setProperty('--day', saved.day);
          if (saved.night) root.classList.add('night');
          root.style.setProperty('--clouds-y', saved.cloudsY);
          root.style.setProperty('--stars-y', saved.starsY);
        }
      } catch {}
    </script>
    {/* where the browser offers it, fetch a page of this site as soon as its link is hovered */}
    <script type="speculationrules" is:inline>
      { "prefetch": [{ "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/*.*" } }] }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body>
    {!home && <a class="skip" href="#content">Skip to content</a>}

    <svg class="unseen" aria-hidden="true">
      <filter id="rim-refraction" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage id="rim-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map"></feImage>
        {/* the scale is twice the largest shift the map asks for: 1.3 x RIM in scripts/glass.js */}
        <feDisplacementMap in="SourceGraphic" in2="map" scale="36.4" xChannelSelector="R" yChannelSelector="B"></feDisplacementMap>
      </filter>
    </svg>

    <header class="bar">
      <nav class="glass" id="glass" aria-label="Main">
        <a class="logo" href="/" aria-label="SC, home">SC</a>
        <div class="pasture" id="pasture" aria-hidden="true"><canvas></canvas></div>
        <div class="links">
          <a href="/projects/" aria-current={section === 'projects' ? 'page' : undefined}>Projects</a>
          <a href="/writing/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/cv.pdf" target="_blank" rel="noreferrer">CV</a>
        </div>
        <button type="button" id="phase" aria-label="Switch to night">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
        </button>
      </nav>
    </header>

    <div class="clouds" aria-hidden="true"></div>
    <div class="stars" aria-hidden="true"></div>

    <slot />

    <script>
      // what every page runs: the sky behind it and the header bar on top
      import '../scripts/sky.js';
      import '../scripts/cow.js';
      import '../scripts/glass.js';
    </script>
  </body>
</html>
