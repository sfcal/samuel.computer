---
import { getCollection, render } from 'astro:content';
import 'temml/dist/Temml-Local.css';
import Base from '../../layouts/Base.astro';
import { isoDate, minutesToRead } from '../../posts.js';
import '../../styles/pages.css';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.excerpt} image={post.data.image?.src} published={post.data.date} section="writing">
  <main class="page" id="content">
    <article class="sheet">
      <a class="back" href="/writing/">← All writing</a>
      <header>
        <p class="meta"><time datetime={isoDate(post)}>{isoDate(post)}</time><span>{minutesToRead(post)} min read</span></p>
        <h1>{post.data.title}</h1>
        <p class="meta">{post.data.tags.map(tag => <span class="tag">#{tag}</span>)}</p>
      </header>
      <div class="prose"><Content /></div>
      <a class="back" href="/writing/">← All writing</a>
    </article>
  </main>

  <script>
    import '../../scripts/videos.js';
  </script>
</Base>
