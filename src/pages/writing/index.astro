---
import Base from '../../layouts/Base.astro';

// One Markdown file per post in src/content/writing/, named by its slug;
// newest first (the frontmatter dates are plain days, "2025-07-30").
const posts = Object.entries(import.meta.glob('../../content/writing/*.md', { eager: true }))
  .map(([path, { frontmatter }]) => ({ slug: path.split('/').pop().slice(0, -'.md'.length), ...frontmatter }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Base title="Writing">
  <main class="page" id="content">
    <div class="column">
      <h1 class="unseen">Writing</h1>
      {posts.map(post => (
        <article class="post">
          <h2><a href={`/writing/${post.slug}/`}>{post.title}</a></h2>
          <p class="meta">
            <time datetime={post.date}>{post.date}</time>
            {post.tags.map(tag => <span class="tag">#{tag}</span>)}
          </p>
          <p class="summary">{post.excerpt}</p>
          <a class="more" href={`/writing/${post.slug}/`} aria-label={`Read more: ${post.title}`}>Read more →</a>
        </article>
      ))}
    </div>
  </main>
</Base>
