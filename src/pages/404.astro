---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
---

<Base title="Page not found" description="There is no page at this address.">
  <main class="page" id="content">
    <div class="column">
      <h1 class="unseen">Page not found</h1>
      <article class="post">
        <h2>Nothing here but sky</h2>
        <p class="summary">There is no page at this address. It may have moved, or never existed.</p>
        <a class="more" href="/">Back home →</a>
      </article>
    </div>
  </main>
</Base>
